! -*- mode: f90 -*-

!===================
&BasicParam
!===================

! Flow type (1=Lock-exchange, 2=TGV, 3=Channel, 4=Periodic hill, 5=Cylinder, 6=dbg-schemes)
itype = 15
! 17(No nozzle), 15 (Nozzle)							

! Domain decomposition	288
p_row=0               ! Row partition
p_col=0               ! Column partition

! Mesh											D20, D40, D80
nx=301                ! X-direction nodes 		241, 481, 481
ny=301                ! Y-direction nodes		240, 480, 960
nz=301                ! Z-direction nodes		240, 480, 960
istret = 0            ! y mesh refinement (0:no, 1:center, 2:both sides, 3:bottom)
beta = 0.0            ! Refinement parameter (beta)

! Domain
xlx = 20.0            ! Lx (Size of the box in x-direction)		20, 40, 40
yly = 20.0             ! Ly (Size of the box in y-direction)	20, 40, 80
zlz = 20.0             ! Lz (Size of the box in z-direction)	20, 40, 80

! Flow parameters
re  = 200.           ! nu=1/re (Kinematic Viscosity)

! Time stepping
dt = 0.01           ! Time step
ifirst = 1            ! First iteration
ilast = 150        ! Last iteration

! Enable modelling tools
ilesmod=0            ! if 0 then DNS
use_les_pm=0
use_buffer_pm=0
numscalar = 0         ! How many scalars? (Set to zero to disable scalars)
iibm=3                ! Flag for immersed boundary method

! Boundary and initial conditions
iin = 1               ! Inflow conditions (1: classic, 2: turbinit, 4: SEM)
u1  = 1.              ! u1 (max velocity) (for inflow condition)
u2  = 0.              ! u2 (min velocity) (for inflow condition)
init_noise = 0.0      ! Turbulence intensity (1=100%) !! Initial condition
inflow_noise = 0.0	    ! Turbulence intensity (1=100%) !! Inflow condition

nclx1 = 2
nclxn = 2
ncly1 = 1
nclyn = 1
nclz1 = 1
nclzn = 1

/End

!====================
&NumOptions
!====================

! Spatial derivatives
ifirstder = 4           ! (1->2nd central, 2->4th central, 3->4th compact, 4-> 6th compact)
isecondder = 4          ! (1->2nd central, 2->4th central, 3->4th compact, 4-> 6th compact, 5->hyperviscous 6th)
ipinter = 2             ! interpolation scheme (1: classic, 2: optimized, 3: optimized agressive)

! Time scheme
itimescheme = 5			!3         ! Time integration scheme (1->Euler,2->AB2, 3->AB3, 4->AB4,5->RK3,6->RK4, 7-->CN2+AB3)

! Dissipation control
nu0nu = 3.0             ! Ratio between hyperviscosity/viscosity at nu
cnu = 0.44              ! Ratio between hypervisvosity at k_m=2/3pi and k_c= pi

/End

!=================
&InOutParam
!=================

! Basic I/O
irestart = 0          ! Read initial flow field ?
icheckpoint = 10  ! Frequency for writing backup file		1000
ioutput = 5         ! Frequency for visualization			500
ilist = 50            ! Frequency for writing to screen 	50       
nvisu = 1             ! Size for visualisation collection

/End

!=================
&ProbesParam
!=================
/End

!=================
&Statistics
!=================

nstat = 1             ! Size arrays for statistic collection
initstat = 1000     ! Time steps after which statistics are collected	1000

/End

!########################
! OPTIONAL PARAMETERS
!#######################

!================
&ibmstuff
!================

 imove = 0      ! (0: Stationary Objects, 1: Moving Objects)
 ubcx=0.0      ! Prescribed Velocity (ux)
 ubcy=0.0       ! Prescribed Velocity (uy)
 ubcz=0.0       ! Prescribed Velocity (uz)
 
 rai=1.0			!0.5      ! when simulating a pipe, inner radius
 rao=1.4			!0.6      ! when simulating a pipe, outer radius (defines wall thickness)
 nraf=10			!10  ! level of refinement for (iibm=2 0r iibm=4) to find the surface of the immersed object
 nobjmax=2      ! number of immersed objects (DO NOT USE ZERO OBJECTS)
 npif=2         ! Number of Points for the Reconstruction (npif=1-3) (Recomended: 2)
 izap=1         ! How many points to skip for reconstruction (Range: 0-3) (Reccomended: 1)
 ianal=0        ! Boundary position approximation? (0: Refinement Approximation, 1: Analytical)

 iforces=0
 nvol=1        !Number of volumes for computing force balance

/End

&ForceCVs

xld(1) = 0.5 	!X left for volume control
xrd(1) = 5.0 	!X right for volume control
yld(1) = 2.0 	!Y bottom for volume control
yud(1) = 8.0 	!Y top for volume control
!zld(1) = 0.01	
!zrd(1) = 9.99

/End

!================
&ScalarParam
!================

numscalar = 0 		  ! How many scalars?
Sc(1) = 0.71          ! Schmidt number

nclxS1 = 2
nclxSn = 2
nclyS1 = 0
nclySn = 0
nclzS1 = 0
nclzSn = 0

/End

!================
&LESModel
!================

jles = 4             ! LES Model (1: Phys Smag, 2: Phys WALE, 3: Phys dyn. Smag, 4: iSVV, 5: dyn SEV)
smagcst = 0.14        ! Smagorinsky constant
SmagWallDamp = 0      ! 1: Mason and Thomson Damping function, otherwise OFF
walecst = 0.5         ! WALES Model Coefficient
iconserv = 0          ! Formulation SGS divergence (0: non conservative, 1: conservative)

/End

!================
&Swirling
!================

alp_p=0.05
del_p=0.1
del_cf=0.2
S_p=2.8			! Swirl Number
len_nz=2.0

/End

!================
&param_common
!================

i_retain_checkpoint = 0
bet_start = 200000
bet_end = 200002
i_del_stat = 1

convVelDiff_p=1d-6	 !Convergence Criteria
convT=5d-1           !Calculates iterations between convergence 

istreakline=0

ihys_td=0
STarg_td=1.8
TTarg_td=200

iSFD=0
iSFD_first_run=0
wc_p=0.05
xi_p=5

isubdom=0
subdom_together=1			 
nx_first=1
nx_last=301
ny_first=46
ny_last=256
nz_first=46
nz_last=256

iplanez0=0
nx_first_z0=1
nx_last_z0=301
ny_first_z0=1
ny_last_z0=301
nz_first_z0=151
nz_last_z0=151

iplaney0=0
nx_first_y0=1
nx_last_y0=301
ny_first_y0=151
ny_last_y0=151
nz_first_y0=1
nz_last_y0=301

/End

!================
&LES_PM
!================

f_alphaX=0.49
f_alphaY=0.49
f_alphaZ=0.49
f_oneSideState=0
f_stateX=1
f_stateY=1
f_stateZ=1
f_order=10
f_leftSurfState=0
f_rightSurfState=1
f_topSurfState=1
f_bottomSurfState=1
f_frontSurfState=1
f_backSurfState=1

/End

!================
&Buffer_PM
!================

b_alphaX=0.4
b_alphaY=0.4
b_alphaZ=0.4
b_oneSideState=0
b_stateX=1
b_stateY=1
b_stateZ=1
b_order=2
b_leftSurfState=0
b_rightSurfState=1
b_topSurfState=1
b_bottomSurfState=1
b_frontSurfState=1
b_backSurfState=1

/End

!================
&BUFF_POSN
!================
xPosnBuff=2
/End
